{
  "name": "suhyeju-com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.6.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "description": "테오AI스프린트6팀 수혜주닷컴",
  "scripts": {
    "prepare": "husky",
    "dev:web": "pnpm --filter @suhyeju/web dev",
    "build:web": "pnpm --filter @suhyeju/web build",
    "vercel-build": "pnpm build:web",
    "start:web": "pnpm --filter @suhyeju/web start",
    "lint:web": "pnpm --filter @suhyeju/web lint",
    "typecheck:web": "pnpm --filter @suhyeju/web typecheck",
    "lint": "eslint eslint.config.mjs commitlint.config.mjs && pnpm run lint:web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "next": "16.2.10",
    "prettier": "^3.4.2"
  }
}
