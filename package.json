{
  "name": "suhyeju-com",
  "version": "0.1.0",
  "private": true,
  "description": "테오AI스프린트6팀 수혜주닷컴",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
