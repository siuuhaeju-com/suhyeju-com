# 수혜주.com apps/web 환경변수 예시
# 실제 값은 .env.local 에 넣는다 (커밋 금지 — .gitignore 처리됨).
# ⚠️ 서버 전용 키에는 NEXT_PUBLIC_ 을 붙이지 않는다 (클라이언트 노출 방지).

# (인기 뉴스는 네이버 증권 ranknews 비공식 API로 전환 — 키 불필요, #53)

# ── GPT (뉴스 분석 #9 / analyze 심장) ──
# 실호출 조건: OPENAI_API_KEY 가 있으면 실제 호출, 없으면 mock 폴백(개발·데모 가능).
#   - GPT_BASE_URL 있음 → 엘리스 OpenAI 호환 프록시(기본 모델 openai/gpt-5.4)
#   - GPT_BASE_URL 없음 → 표준 OpenAI api.openai.com (기본 모델 gpt-4o, 키는 sk-…)
OPENAI_API_KEY=your_openai_or_gateway_key
# 엘리스 게이트웨이를 쓸 때만 채운다. 표준 OpenAI면 비워둔다.
GPT_BASE_URL=
# 모델명 덮어쓰기(선택). 미설정 시 위 규칙의 기본값(openai/gpt-5.4 또는 gpt-4o).
GPT_MODEL=

# analyze mock 강제 스위치: 1 또는 true 이면 키가 있어도 mock 사용.
# 비워두면 자동 판단(키 있으면 실제, 없으면 mock).
MOCK_ANALYZE=

# ── 분석 결과 저장소 (KV, 이슈 #9) ──
# 있으면 분석 결과를 Upstash Redis에 영속 저장, 없으면 인메모리 폴백(휘발).
# ⚠️ 서버리스 배포(Vercel 등)에서는 인메모리가 인스턴스 간 공유 안 돼 404가 날 수 있어 KV 필수.
#   Vercel: Storage 탭에서 Upstash Redis 연결 시 자동 주입됨.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
