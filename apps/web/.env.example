# 수혜주.com apps/web 환경변수 예시
# 실제 값은 .env.local 에 넣는다 (커밋 금지 — .gitignore 처리됨).
# ⚠️ 서버 전용 키에는 NEXT_PUBLIC_ 을 붙이지 않는다 (클라이언트 노출 방지).

# ── 네이버 검색 API (인기 뉴스 #33) ──
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ── GPT 게이트웨이 (뉴스 분석 #9 / analyze 심장) ──
# 엘리스 OpenAI 호환 프록시(openai/gpt-5.4).
# GPT_BASE_URL 미설정 시 /api/analyze 는 mock 폴백으로 동작한다(개발·데모 가능).
# 주소가 확보되면 아래 두 값을 채우면 자동으로 실제 호출로 전환된다.
GPT_BASE_URL=https://mlapi.run/<api_id>/v1
OPENAI_API_KEY=your_gpt_gateway_bearer_key

# analyze mock 강제 스위치: 1 또는 true 이면 base_url 이 있어도 mock 사용.
# 비워두면 자동 판단(base_url 있으면 실제, 없으면 mock).
MOCK_ANALYZE=
